{
  "name": "mediamtx-webrtc-react",
  "version": "1.0.0",
  "description": "TypeScript/React-compatible WebRTC reader for MediaMTX WHEP streams",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "preinstall": "npx only-allow pnpm"
  },
  "packageManager": "pnpm@10.18.1",
  "keywords": [
    "webrtc",
    "mediamtx",
    "whep",
    "streaming",
    "typescript",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@types/react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}