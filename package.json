{
  "name": "mediamtx-webrtc-react",
  "version": "0.1.0",
  "description": "TypeScript/React-compatible WebRTC reader for MediaMTX WHEP streams",
  "homepage": "https://mrlightful.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrLightful/mediamtx-webrtc-react.git"
  },
  "author": {
    "name": "Roman Sirokov",
    "url": "https://mrlightful.com",
    "email": "roman@mrlightful.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "webrtc",
    "mediamtx",
    "whep",
    "streaming",
    "typescript",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "preinstall": "npx only-allow pnpm"
  },
  "packageManager": "pnpm@10.18.1",
  "peerDependencies": {
    "@types/react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
